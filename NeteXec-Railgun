usage() {
    banner
    cat <<EOF
${C_BOLD}Usage:${C_RESET} NeteXec-Railgun -t <targets> -u <user|file> -p <pass|file> [options]
       NeteXec-Railgun -t <targets> -C <combo.txt> [options]

${C_BOLD}Credentials:${C_RESET}
  -t, --targets   Target(s): IP, CIDR, hostname, or a file of targets.
  -u, --user      Username, or a file with one username per line.
  -p, --pass      Password, or a file with one password per line.
  -H, --hash      NTLM hash (pass-the-hash) instead of / in addition to -p.
  -C, --combo     Combo file of user:pass pairs (tested as pairs, not matrix).
  -d, --domain    Domain name (for AD auth).
      --local     Use local authentication (nxc --local-auth).
      --continue  Do NOT stop a protocol on first valid login (spray fully).

${C_BOLD}Scope:${C_RESET}
  -P, --protocols Comma-separated subset, e.g. -P smb,winrm,mssql
                  (default: all -> ${PROTOCOLS[*]})
      --nmap FILE Build targets from nmap output (-oG greppable, -oX XML, or a
                  plain host list). Each protocol is only sprayed at hosts with
                  a matching port open (smb->445, winrm->5985, rdp->3389, ...),
                  so you skip dead protocols. Replaces -t when given.

${C_BOLD}Enumeration depth:${C_RESET}
      --enum            Run enumeration modules alongside auth (standard level).
      --enum-level L    light | standard | deep   (implies --enum)
      --enum-cats a,b   Granular categories (implies --enum), overrides level:
                        shares users groups policy sessions roast deleg rid db

${C_BOLD}Post-exploit shortcuts:${C_RESET}
      --post            On a valid/Pwn3d hit, auto-run follow-up nxc modules
                        for that credential (safe per-protocol defaults).
      --post-mods a,b   Explicit shortcut list (implies --post), overrides
                        per-protocol defaults. Shortcuts -> nxc module(s):
                          secrets     smb   --sam --lsa            (default)
                          spider      smb   -M spider_plus         (default)
                          ntds        smb   --ntds                 (opt-in only)
                          bloodhound  ldap  --bloodhound -c All    (default)
                          exec        winrm -x whoami              (default)
                          xpcmd       mssql -x whoami              (opt-in only)
                          screenshot  rdp/vnc -M screenshot        (default)
                        ntds and xpcmd are opt-in only (never in the default
                        set) since they dump the domain DB / prove RCE.
      --pth-chain       After the run, harvest NTLM hashes dumped by --post
                        (--sam/--lsa/--ntds) and re-spray them pass-the-hash
                        across the auth-capable protocols (implies --post).
                        One extra round only - harvested hashes are never
                        re-chained. Machine ($) and empty-password hashes are
                        skipped. Logs land under <run>/chain/.

${C_BOLD}Reliability / lockout safety:${C_RESET}
      --timeout N       Per-nxc-call timeout in seconds (default: ${TIMEOUT_DEF}).
      --retries N       Retries on timeout per call (default: ${RETRIES_DEF}).
      --resume          Skip protocols whose log already exists in the run dir.
      --lockout-guard N Stop trying a username once it hits N consecutive auth
                        failures (across passwords/protocols), so a spray never
                        locks out the account you need. Timeouts don't count.
      --jitter N        Sleep a random 0-N seconds between auth attempts to
                        stay under lockout-window thresholds.

${C_BOLD}Output / UX:${C_RESET}
  -o, --output    Base output directory (default: ${OUTBASE_DEF}).
      --show          Stream live output by default (otherwise hidden; press v).
      --only-success  Summary shows only protocols with valid logins.
      --dry-run       Print the nxc commands that would run, then exit.
  -x, --extra     Extra args passed straight to nxc (quote them).

${C_BOLD}Config:${C_RESET}
  -c, --config          Load settings from a config file (KEY=value).
      --save-config F   Write the current settings to file F and exit.
      --no-config       Do not auto-load ./railgun.conf.

  -h, --help      Show this help.

