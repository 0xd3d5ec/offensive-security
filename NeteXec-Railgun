#!/usr/bin/env bash
#
# NeteXec-Railgun  -  spray supplied credentials across every NetExec protocol
#
# Wrapper around NetExec (nxc) built for the OSCP lab/exam: feed it the creds
# you loot during the exam once, and it re-tries them against SMB, SSH, LDAP,
# WinRM, WMI, RDP, MSSQL, FTP, VNC and NFS so you never have to re-type the
# same command per protocol.

set -u

# ---------------------------------------------------------------------------
# Edit this to taste - shown under the banner.
DEVELOPER="An0n"
VERSION="v1.3"
# ---------------------------------------------------------------------------

# Protocols NetExec actually ships modules for.
PROTOCOLS=(smb ssh ldap ftp winrm wmi rdp mssql vnc nfs)

# --- defaults --------------------------------------------------------------
TIMEOUT_DEF=90; RETRIES_DEF=1; OUTBASE_DEF="./railgun-out"

# --- colours ---------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'; C_RED=$'\e[31m'; C_GREEN=$'\e[32m'
    C_YELLOW=$'\e[33m'; C_BLUE=$'\e[34m'; C_CYAN=$'\e[36m'; C_BOLD=$'\e[1m'
else
    C_RESET=; C_RED=; C_GREEN=; C_YELLOW=; C_BLUE=; C_CYAN=; C_BOLD=
fi

